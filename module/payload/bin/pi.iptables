#!/system/bin/sh
# Pi-Sing -- transparent proxy (TPROXY) rules for a single sing-box tproxy inbound.
#
#   pi.iptables on|renew     install rules (IPv4, plus IPv6 in ipv6=proxy)
#   pi.iptables off          remove every rule installed by this script
#   pi.iptables status       show what is currently installed
#   pi.iptables watchdog-... (not here, see pi-sing)
#
# Design (measured on the target device, OnePlus CPH2747 / Android 17 / kernel 6.12):
#  * mangle PREROUTING is empty on Android, so bypass there uses ACCEPT. mangle
#    OUTPUT carries vendor chains (qcom_NWMGR, oplus_tos_mapping, connmark_*),
#    so bypass there must use RETURN and never ACCEPT.
#  * DNS (port 53 tcp+udp) is TPROXY'd to the same inbound and answered by the
#    sing-box route rule {"protocol":"dns","action":"hijack-dns"}; the rule sits
#    before every bypass so a private resolver is hijacked too.
#  * Locally generated traffic is marked in mangle OUTPUT and delivered to the
#    tproxy socket through `ip rule fwmark ... table <table>` + a local route to
#    lo, then re-enters PREROUTING on lo.
#  * Loop protection: the core runs with a dedicated gid (net_admin = 3005) and
#    mangle OUTPUT returns on that gid; SO_MARK (own_mark) is a second guard.
#  * ipv6=proxy installs the same rule set with ip6tables (+ `ip -6 rule/route`),
#    ipv6=block leaves IPv6 unproxied but rejects it, so it cannot leak,
#    ipv6=disable switches the IPv6 stack off (sysctl), so netd has no IPv6
#    resolver left to leak through, ipv6=off does nothing (IPv6 goes direct).
#
#  * `on`/`renew` replace the rule set in place: one ip[6]tables-restore
#    --noflush transaction per table, so no packet sees a table without the
#    hooks. A table that refuses its batch gets the old path instead (remove
#    everything, then one rule at a time), and the log says so.
#  * mangle INPUT drops whatever reaches the tproxy port without the TPROXY
#    mark, for IPv4 and IPv6 and in every ipv6= mode: a connection made to the
#    port itself makes the core dial itself.
#
# PISING_DRY_RUN=1 prints every command instead of running it: the only way to
# see what a ROM with unusual chains would get without breaking the network.
set -u

PISING_DIR="${PISING_DIR:-/data/adb/pi-sing}"
settings="${PISING_DIR}/settings.ini"
run_dir="${PISING_DIR}/run"

[ -f "$settings" ] || { printf 'pi.iptables: settings not found: %s\n' "$settings" >&2; exit 1; }
. "$settings"
[ -n "${list_dir:-}" ] ||
    { printf 'pi.iptables: %s is from an older layout, reinstall the module\n' "$settings" >&2; exit 1; }

log_dir="${log_dir:-${run_dir}/log}"
module_log="${log_dir}/module.log"
mkdir -p "$run_dir" "$log_dir" 2>/dev/null

# Same file as the CLI, tagged [rules], so `pi-sing log` shows the whole story
# in order. PISING_QUIET=1 is set when the CLI calls this script: the line is
# already in the log and printing it again would duplicate it in service output.
log() {
    _lvl="$1"; shift
    _msg="$(date '+%Y-%m-%d %H:%M:%S') [${_lvl}] [rules] $*"
    _size=0
    [ -f "$module_log" ] && _size=$(wc -c < "$module_log" 2>/dev/null)
    if [ "${_size:-0}" -gt 262144 ]; then
        mv -f "$module_log" "${module_log}.1" 2>/dev/null
    fi
    printf '%s\n' "$_msg" >> "$module_log" 2>/dev/null
    [ "${PISING_QUIET:-0}" = "1" ] || printf '%s\n' "$_msg"
    return 0
}

# Android 11+ ships iptables 1.8, which takes the xtables lock; -w waits for it.
IPT_WAIT=""
if iptables -w 100 -t mangle -S >/dev/null 2>&1; then
    IPT_WAIT="-w 100"
fi

# PISING_DRY_RUN=1: print the command line, do not run it, report "not done"
# so callers that loop until success (rule delete, sysctl) stop after one line.
DRY_RUN="${PISING_DRY_RUN:-0}"
dry() {
    [ "$DRY_RUN" = "1" ] || return 1
    printf '[dry-run] %s\n' "$*" >&2
    return 0
}

# `on` hands each table to ip[6]tables-restore as one transaction (batch_commit
# below): while BATCH is set, i4/i6 record the rule instead of running it, and
# the builders do not know the difference. Recorded in variables, not files:
# printf is an external command in Android's mksh, one fork per rule.
BATCH=""
B_MANGLE=""
B_FILTER=""
NL='
'
batch_add() {  # -t <table> <rule...>, the way every builder calls i4/i6
    _btab="$2"; shift 2
    case "$_btab" in
        mangle) B_MANGLE="${B_MANGLE}$*${NL}" ;;
        filter) B_FILTER="${B_FILTER}$*${NL}" ;;
    esac
    return 0
}

i4() {
    [ -n "$BATCH" ] && { batch_add "$@"; return 0; }
    dry iptables $IPT_WAIT "$@" && return 0; iptables $IPT_WAIT "$@"
}
i6() {
    [ -n "$BATCH" ] && { batch_add "$@"; return 0; }
    dry ip6tables $IPT_WAIT "$@" && return 0; ip6tables $IPT_WAIT "$@"
}

# Write-side `ip` wrapper; read-side calls (`ip rule show`) stay real.
ipw() {  # $1 = 4|6, rest = ip arguments
    _pfam="$1"; shift
    if [ "$DRY_RUN" = "1" ]; then
        if [ "$_pfam" = 6 ]; then dry ip -6 "$@"; else dry ip "$@"; fi
        return 1
    fi
    if [ "$_pfam" = 6 ]; then ip -6 "$@"; else ip "$@"; fi
}

# $1 = /proc/sys path, $2 = value
sysctl_write() {
    dry "echo $2 > $1" && return 0
    printf '%s\n' "$2" > "$1" 2>/dev/null
}

c_ext="PISING_EXT"      # PREROUTING, capture
c_local="PISING_LOCAL"  # OUTPUT, mark
c_divert="PISING_DIVERT" # PREROUTING, already handled sockets
c_bypass="PISING_BYPASS" # PREROUTING, ACCEPT private/local destinations
c_guard="PISING_GUARD"  # filter OUTPUT, reject direct tproxy port and QUIC
c_input="PISING_INPUT"  # mangle INPUT, drop the tproxy port unless TPROXY'd
c_v6="PISING_V6BLOCK"   # filter OUTPUT/FORWARD, reject IPv6 in ipv6=block

# 198.18.0.0/15 and fc00::/18 are deliberately absent: sing-box fakeip uses
# those ranges and traffic to a fake address must be proxied, not bypassed.
intranet4="0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.88.99.0/24 192.168.0.0/16 198.51.100.0/24 203.0.113.0/24 224.0.0.0/4 240.0.0.0/4 255.255.255.255/32"
intranet6="::/128 ::1/128 ::ffff:0:0/96 100::/64 64:ff9b::/96 2001:db8::/32 fe80::/10 ff00::/8"

# Ranges that belong to a tunnel endpoint rather than to the local network: they
# are captured like any public destination instead of being bypassed, so the
# endpoint's route rule (`preferred_by`) can reach them. Measured 2026-11-12:
# with 100.64.0.0/10 on both bypass lists, no tailnet peer was reachable from the
# phone or from the container, while the peer's own handshake counters moved (the
# kernel sent the packets out of the uplink, where nothing answers). Capturing
# the range made an SSH banner from a peer arrive, and it needed both halves:
# MARK in PISING_LOCAL only = timeout, TPROXY ahead of PISING_BYPASS only =
# timeout, both = banner. `tailnet4` is a settings.ini knob; empty keeps every
# range on the bypass lists.
intranet4_bypass=""
for _cidr in $intranet4; do
    case " ${tailnet4:-} " in
        *" $_cidr "*) continue ;;
    esac
    intranet4_bypass="${intranet4_bypass} ${_cidr}"
done

packages_list_file="/data/system/packages.list"

# ------------------------------------------------------------------ helpers

local_addrs() {
    case "$1" in
        6) ip -6 -o addr show 2>/dev/null | awk '{ print $4 }' | grep -vE '^(fe80|::1/)' ;;
        *) ip -4 -o addr show 2>/dev/null | awk '{ if ($2 != "lo") print $4 }' ;;
    esac
}

# Resolve package.list.cfg entries to uids in ${uid_file}. Both files are read
# once: the old form ran one awk per app against packages.list, which is a fork
# per entry on every start. Unresolved entries are marked with a leading "!" so
# the normal uids stay in one file.
read_uid_list() {
    : > "$uid_file" 2>/dev/null
    pkg_cfg="${list_dir}/package.list.cfg"
    [ -f "$pkg_cfg" ] || return 0
    _raw="${run_dir}/appuid.raw"
    # Not every host has the Android package database (the netns test does not);
    # a missing file must still resolve numeric uids instead of failing awk.
    _pkgs="$packages_list_file"
    [ -f "$_pkgs" ] || _pkgs=/dev/null
    awk -v cfg="$pkg_cfg" '
        function trim(s) { gsub(/^[ \t\r]+/, "", s); gsub(/[ \t\r]+$/, "", s); return s }
        FILENAME == cfg {
            line = $0
            sub(/[ \t]*#.*/, "", line)
            line = trim(line)
            if (line == "" || line ~ /^mode:/) next
            entry[++n] = line
            next
        }
        { appid[$1] = $2 }
        END {
            for (i = 1; i <= n; i++) {
                e = entry[i]
                if (e !~ /[^0-9]/) { print e; continue }
                user = 0; pkg = e
                p = index(e, ":")
                if (p > 0) { user = substr(e, 1, p - 1); pkg = substr(e, p + 1) }
                if (user !~ /^[0-9]+$/) user = 0
                if (pkg in appid) print (user * 100000 + appid[pkg])
                else print "!" pkg ":" user
            }
        }' "$pkg_cfg" "$_pkgs" > "$_raw" 2>/dev/null
    grep -v '^!' "$_raw" >> "$uid_file" 2>/dev/null
    grep '^!' "$_raw" 2>/dev/null | while IFS= read -r _miss; do
        _miss="${_miss#!}"
        log Warn "uid not found for ${_miss%%:*} (user ${_miss#*:}), skipped"
    done
    rm -f "$_raw"
    return 0
}

# Interface carrying the default route: the uplink. Its *ingress* must never be
# captured, or traffic that merely passes through gets proxied (and on the
# dev/agent container that path is the host's own network).
uplink_interface() {
    # PISING_UPLINK_IF overrides the detection: `ip route get` answers from the
    # fwmark-free main table, which on Android is not necessarily the network
    # that carries traffic, and the tests need a deterministic answer.
    if [ -n "${PISING_UPLINK_IF:-}" ]; then
        printf '%s\n' "$PISING_UPLINK_IF"
        return 0
    fi
    for _gw in 1.1.1.1 8.8.8.8; do
        _u="$(ip route get "$_gw" 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')"
        [ -n "${_u:-}" ] && { printf '%s\n' "$_u"; return 0; }
    done
    printf '%s\n' "$(ip -4 -o route show default 2>/dev/null | awk '{ print $NF; exit }' | sed 's/.*dev //')"
}

read_ap_list() {
    : > "${run_dir}/ap.list" 2>/dev/null
    cfg="${list_dir}/ap.list.cfg"
    [ -f "$cfg" ] || return 0
    _uplink="$(uplink_interface)"
    awk -v uplink="${_uplink:-}" '
        /^[ \t]*allow[ \t]+/ {
            ap = $2
            base = ap
            sub(/\+$/, "", base)
            # wlan2 is the hotspot on some phones and the uplink on others: the
            # pattern is kept, but it is dropped when it is the current uplink.
            if (uplink != "" && index(uplink, base) == 1) next
            print ap
        }' "$cfg" >> "${run_dir}/ap.list"
    return 0
}

# Delete every occurrence of a rule (max 5) so `on` is idempotent.
del_all() {
    _ipt="$1"; shift
    dry "$_ipt" $IPT_WAIT "$@" && return 0
    _n=0
    while [ "$_n" -lt 5 ] && $_ipt "$@" >/dev/null 2>&1; do
        _n=$((_n + 1))
    done
}

# --------------------------------------------------------------- rule setup

# $1 = i4|i6, $2 = chain, $3 = list, $4 = verdict (ACCEPT|RETURN)
build_skip() {
    _ipt="$1"; _chain="$2"; _list="$3"; _verdict="$4"
    for _cidr in $_list; do
        $_ipt -t mangle -A "$_chain" -d "$_cidr" -j "$_verdict"
    done
}

build_ext() {
    _ipt="$1"
    _dns_only="${2:-no}"
    if [ "$_dns_only" != no ]; then
        # ipv6=block: only DNS is captured, everything else stays rejected.
        $_ipt -t mangle -A "$c_ext" -p tcp --dport 53 -j TPROXY --on-port "$tproxy_port" --tproxy-mark "$fwmark"
        $_ipt -t mangle -A "$c_ext" -p udp --dport 53 -j TPROXY --on-port "$tproxy_port" --tproxy-mark "$fwmark"
        return 0
    fi
    # 1. interfaces that must never be touched (containers, VM bridges, dummy).
    for _if in $bypass_interfaces; do
        $_ipt -t mangle -A "$c_ext" -i "$_if" -j ACCEPT
    done
    # 2. DNS hijack before any bypass, so a private resolver is hijacked too.
    $_ipt -t mangle -A "$c_ext" -p tcp --dport 53 -j TPROXY --on-port "$tproxy_port" --tproxy-mark "$fwmark"
    $_ipt -t mangle -A "$c_ext" -p udp --dport 53 -j TPROXY --on-port "$tproxy_port" --tproxy-mark "$fwmark"
    # 3. private / device-local destinations leave the hook (ACCEPT: mangle
    #    PREROUTING is otherwise empty on Android).
    $_ipt -t mangle -A "$c_ext" -j "$c_bypass"
    # 4. traffic re-entering through lo is locally generated, already marked.
    $_ipt -t mangle -A "$c_ext" -p tcp -i lo -j TPROXY --on-port "$tproxy_port" --tproxy-mark "$fwmark"
    $_ipt -t mangle -A "$c_ext" -p udp -i lo -j TPROXY --on-port "$tproxy_port" --tproxy-mark "$fwmark"
    # 5. hotspot / tether clients.
    if [ -s "${run_dir}/ap.list" ]; then
        while IFS= read -r ap; do
            [ -n "$ap" ] || continue
            $_ipt -t mangle -A "$c_ext" -p tcp -i "$ap" -j TPROXY --on-port "$tproxy_port" --tproxy-mark "$fwmark" 2>/dev/null ||
                log Warn "iface ${ap} not available yet, skipped"
            $_ipt -t mangle -A "$c_ext" -p udp -i "$ap" -j TPROXY --on-port "$tproxy_port" --tproxy-mark "$fwmark" 2>/dev/null ||
                log Warn "iface ${ap} not available yet, skipped"
        done < "${run_dir}/ap.list"
    fi
}

build_local() {
    _ipt="$1"
    _dns_only="${2:-no}"
    _fam="${3:-4}"
    # 1. the core itself, by gid when pi-sing could set one, else by uid 0.
    _core_gid="$(cat "${run_dir}/core.gid" 2>/dev/null)"
    if [ -n "${_core_gid:-}" ]; then
        $_ipt -t mangle -A "$c_local" -m owner --gid-owner "$_core_gid" -j RETURN
    else
        $_ipt -t mangle -A "$c_local" -m owner --uid-owner 0 -j RETURN
    fi
    # 2. second guard: SO_MARK set by the core's own outbound sockets.
    $_ipt -t mangle -A "$c_local" -m mark --mark "$own_mark" -j RETURN
    if [ "$_dns_only" != no ]; then
        # ipv6=block: mark DNS only, so it is hijacked like the IPv4 one. The
        # phone resolves names through netd, which talks plain DNS to a
        # link-local resolver (measured: fe80::1%wlan0), so this path matters.
        $_ipt -t mangle -A "$c_local" -p tcp --dport 53 -j MARK --set-xmark "$fwmark"
        $_ipt -t mangle -A "$c_local" -p udp --dport 53 -j MARK --set-xmark "$fwmark"
        return 0
    fi
    # 3. interfaces excluded from proxying.
    for _if in $ignore_interfaces; do
        $_ipt -t mangle -A "$c_local" -o "$_if" -j RETURN
    done
    # 4. DNS is hijacked for every app, in both blacklist and whitelist mode.
    #    Ahead of the intranet RETURN below, or a private resolver leaks.
    $_ipt -t mangle -A "$c_local" -p tcp --dport 53 -j MARK --set-xmark "$fwmark"
    $_ipt -t mangle -A "$c_local" -p udp --dport 53 -j MARK --set-xmark "$fwmark"
    # 5. private / device-local destinations: RETURN, never ACCEPT (the vendor
    #    chains behind us in mangle OUTPUT must still run). These rules live in
    #    this chain on purpose: a RETURN inside a chain this one jumps to only
    #    resumes *here*, so the blanket MARK below caught every intranet packet
    #    too (measured 2026-11-05: the phone's own TCP to a LAN printer,
    #    192.168.1.100:9100, stayed SYN_SENT/UNREPLIED in conntrack while the
    #    rules were up, and connected the moment `pi-sing stop` ran).
    if [ "$_fam" = 6 ]; then
        build_skip "$_ipt" "$c_local" "$intranet6 $(local_addrs 6)" RETURN
    else
        build_skip "$_ipt" "$c_local" "$intranet4_bypass $(local_addrs 4)" RETURN
    fi
    # 6. per-app selection.
    _uids=""
    [ -f "$uid_file" ] && _uids="$(sort -u "$uid_file" 2>/dev/null)"
    case "$proxy_mode" in
        white|whitelist)
            for _uid in $_uids; do
                $_ipt -t mangle -A "$c_local" -p tcp -m owner --uid-owner "$_uid" -j MARK --set-xmark "$fwmark"
                $_ipt -t mangle -A "$c_local" -p udp -m owner --uid-owner "$_uid" -j MARK --set-xmark "$fwmark"
            done
            # unlisted apps stay direct
            ;;
        *)
            for _uid in $_uids; do
                $_ipt -t mangle -A "$c_local" -m owner --uid-owner "$_uid" -j RETURN
            done
            $_ipt -t mangle -A "$c_local" -p tcp -j MARK --set-xmark "$fwmark"
            $_ipt -t mangle -A "$c_local" -p udp -j MARK --set-xmark "$fwmark"
            ;;
    esac
}

build_guard() {
    _ipt="$1"
    # QUIC: block UDP 443/80 so applications fall back to TCP.
    if [ "$quic" = "disable" ]; then
        $_ipt -t filter -A "$c_guard" -p udp --dport 443 -j REJECT
        $_ipt -t filter -A "$c_guard" -p udp --dport 80 -j REJECT
    fi
    # Nothing may connect to the tproxy port directly (loop prevention).
    case "$_ipt" in
        i6) $_ipt -t filter -A "$c_guard" -d ::1 -p tcp --dport "$tproxy_port" -j REJECT ;;
        *)  $_ipt -t filter -A "$c_guard" -d 127.0.0.1 -p tcp --dport "$tproxy_port" -j REJECT ;;
    esac
}

# Nothing but a TPROXY'd packet may reach the tproxy port. The inbound listens on
# every address ("listen": "::"), and a connection made *to* the port has the
# port itself as its destination: the core dials it, which is itself, and every
# dial is the next inbound connection. Measured 2026-11-21 in a netns with
# sing-box 1.14.4 and these rules: one TCP connection held for 1 s by a LAN
# neighbour kept the core busy for ~30 s (110 878 fds, 37.5 CPU-seconds, RSS
# 26 -> 265 MiB), one UDP datagram was 19 307 inbound packet connections in 5 s
# and still going, and an app on the phone got there too, through the phone's
# own LAN address or [::1]. The 127.0.0.1 rule in PISING_GUARD covers none of
# that. A packet TPROXY delivered carries the fwmark (--tproxy-mark, or
# PISING_DIVERT) and still has the destination the app asked for, so "to the
# tproxy port and not marked" is exactly a connection to the listener itself;
# a proxied connection to <somewhere>:<tproxy_port> is marked and passes.
# The chain is hooked first in *mangle* INPUT, and DROP is all mangle has: by
# the time the filter table sees the packet the mark is netd's. Read on the
# device 2026-11-21: `-A routectrl_mangle_INPUT -i wlan0 -j MARK --set-xmark
# 0x300cd/0x7fefffff`, one such rule per interface netd manages, and that mask
# covers the fwmark bit - a REJECT in filter INPUT would have refused a hotspot
# client's proxied connection to port <tproxy_port> as well.
build_input() {
    _ipt="$1"
    $_ipt -t mangle -A "$c_input" -p tcp --dport "$tproxy_port" -m mark ! --mark "$fwmark" -j DROP
    $_ipt -t mangle -A "$c_input" -p udp --dport "$tproxy_port" -m mark ! --mark "$fwmark" -j DROP
}

# build_input for the IPv6 side of the modes that install no other IPv6 rule set:
# the inbound is dual-stack whatever `ipv6=` says.
apply_input() {  # $1 = i4|i6
    _ipt="$1"
    if [ -z "$BATCH" ]; then
        $_ipt -t mangle -N "$c_input" 2>/dev/null
        $_ipt -t mangle -F "$c_input" 2>/dev/null
    fi
    build_input "$_ipt"
    [ -n "$BATCH" ] && return 0
    $_ipt -t mangle -I INPUT -j "$c_input"
    return 0
}

apply_proto() {
    _ipt="$1"            # i4 | i6
    _fam="$2"            # 4 | 6
    # `on` does not remove the rule first any more, and a second `rule add` is
    # a second rule on a kernel that does not refuse it.
    case "$_fam" in
        6) _have="$(ip -6 rule show 2>/dev/null)" ;;
        *) _have="$(ip rule show 2>/dev/null)" ;;
    esac
    case "${_have}${NL}" in
        *"lookup ${table}${NL}"*|*"lookup ${table} "*) ;;
        *) ipw "$_fam" rule add fwmark "$fwmark" table "$table" pref "$pref" 2>/dev/null ;;
    esac
    ipw "$_fam" route replace local default dev lo table "$table" 2>/dev/null ||
        log Error "cannot add local default route to table ${table}"

    # A batch names its chains instead: created or flushed in the same commit.
    if [ -z "$BATCH" ]; then
        for _c in "$c_ext" "$c_local" "$c_divert" "$c_bypass" "$c_input"; do
            $_ipt -t mangle -N "$_c" 2>/dev/null
            $_ipt -t mangle -F "$_c" 2>/dev/null
        done
        # v1.8.5 and older kept the intranet RETURNs in this nested chain.
        $_ipt -t mangle -F PISING_SKIP 2>/dev/null
        $_ipt -t mangle -X PISING_SKIP 2>/dev/null
        $_ipt -t filter -N "$c_guard" 2>/dev/null
        $_ipt -t filter -F "$c_guard" 2>/dev/null
    fi

    if [ "$_fam" = 6 ]; then
        build_skip "$_ipt" "$c_bypass" "$intranet6 $(local_addrs 6)" ACCEPT
    else
        build_skip "$_ipt" "$c_bypass" "$intranet4_bypass $(local_addrs 4)" ACCEPT
    fi
    build_ext "$_ipt" "${3:-no}"
    build_local "$_ipt" "${3:-no}" "$_fam"
    build_guard "$_ipt"
    build_input "$_ipt"

    # Already-handled socket (established tproxy connection): mark and accept.
    $_ipt -t mangle -A "$c_divert" -j MARK --set-xmark "$fwmark"
    $_ipt -t mangle -A "$c_divert" -j ACCEPT

    # A batch puts the hooks back itself, in the commit that refills the chains.
    [ -n "$BATCH" ] && return 0

    $_ipt -t mangle -I PREROUTING -j "$c_ext"
    if $_ipt -t mangle -I PREROUTING -p tcp -m socket --transparent -j "$c_divert" 2>/dev/null; then
        :
    else
        log Warn "xt_socket mangle PREROUTING unsupported, skipping DIVERT"
    fi
    $_ipt -t mangle -I OUTPUT -j "$c_local"
    $_ipt -t mangle -I INPUT -j "$c_input"
    $_ipt -t filter -I OUTPUT -j "$c_guard"
    return 0
}

# ipv6=block: IPv6 is not proxied, so it must not reach the network either.
apply_v6_block() {
    if [ -z "$BATCH" ]; then
        i6 -t filter -N "$c_v6" 2>/dev/null
        i6 -t filter -F "$c_v6" 2>/dev/null
    fi
    # Link-local and multicast stay untouched *before* the DNS reject, because a
    # link-local resolver is the only working one on some networks: netd held
    # fe80::1%wlan0 as its resolver while 1.1.1.1/1.0.0.1 were marked BROKEN
    # (18/24 and 24/24 timeouts, score 0, sample validity 1800 s), and rejecting
    # IPv6 DNS then left it with no resolver at all: every name that was not
    # cached failed with "unknown host" (measured 8/8 with the module running,
    # 8/8 resolving with it stopped). Letting the link-local query out costs a
    # DNS leak to the LAN router; the alternative is a phone without DNS.
    i6 -t filter -A "$c_v6" -d fe80::/10 -j RETURN
    i6 -t filter -A "$c_v6" -d ff00::/8 -j RETURN
    # Global IPv6 DNS is still rejected: nothing on this path is proxied, and
    # answering from a public resolver would be a leak with no benefit.
    i6 -t filter -A "$c_v6" -p udp --dport 53 -j REJECT
    i6 -t filter -A "$c_v6" -p tcp --dport 53 -j REJECT --reject-with tcp-reset
    i6 -t filter -A "$c_v6" -j REJECT
    [ -n "$BATCH" ] && return 0
    i6 -t filter -I OUTPUT -j "$c_v6"
    i6 -t filter -I FORWARD -j "$c_v6"
    return 0
}

teardown_proto() {
    _ipt="$1"
    _fam="$2"

    del_all "$_ipt" -t mangle -D PREROUTING -j "$c_ext"
    # the match spec must be identical to the inserted rule or -D does not match
    del_all "$_ipt" -t mangle -D PREROUTING -p tcp -m socket --transparent -j "$c_divert"
    del_all "$_ipt" -t mangle -D OUTPUT -j "$c_local"
    del_all "$_ipt" -t mangle -D INPUT -j "$c_input"
    del_all "$_ipt" -t filter -D OUTPUT -j "$c_guard"
    del_all "$_ipt" -t filter -D OUTPUT -j "$c_v6"
    del_all "$_ipt" -t filter -D FORWARD -j "$c_v6"

    for _c in "$c_ext" "$c_local" "$c_divert" "$c_bypass" "$c_input" PISING_SKIP; do
        $_ipt -t mangle -F "$_c" 2>/dev/null
        $_ipt -t mangle -X "$_c" 2>/dev/null
    done
    for _c in "$c_guard" "$c_v6"; do
        $_ipt -t filter -F "$_c" 2>/dev/null
        $_ipt -t filter -X "$_c" 2>/dev/null
    done

    _n=0
    while [ "$_n" -lt 5 ] && ipw "$_fam" rule del fwmark "$fwmark" table "$table" pref "$pref" 2>/dev/null; do
        _n=$((_n + 1))
    done
    ipw "$_fam" route flush table "$table" 2>/dev/null
    return 0
}

# ------------------------------------------------- one transaction per table
#
# `on` used to remove every rule and then build the set again, one iptables call
# per rule (108 of them). Measured in module.log on the device, 2026-11-16..21
# (5.25 days): 91 rebuilds, the rules gone for a median of 4 s, p90 14 s, 63 s
# at worst - 128 s a day in which IPv4 left unproxied, port 53 was not hijacked
# and, with ipv6=disable, the IPv6 stack was switched back on, each time right
# after the network had changed. ip[6]tables-restore --noflush replaces a table
# in one commit (it is how netd writes its own rules): a chain named in the
# batch is created or flushed and refilled, our hooks are taken out and put back
# on top, and no packet ever sees the table without them.

# What the last `on` installed for IPv6 (the ipv6_mode word). Its absence means
# there is nothing `on` may build on.
rules_stamp="${run_dir}/rules.ipv6"

# Our hooks as they are in a table right now, as deletes for the batch. Every
# occurrence is listed, so a hook that was doubled, or pushed down by somebody
# else's -I, is there once and first again after the commit.
hook_deletes() {  # $1 = iptables|ip6tables, $2 = table
    "$1" $IPT_WAIT -t "$2" -S 2>/dev/null |
        awk '$1 == "-A" && $2 !~ /^PISING_/ && $(NF - 1) == "-j" && $NF ~ /^PISING_/ { $1 = "-D"; print }'
}

# $1 = 4|6, $2 = table, $3 = the chains the batch owns, $4 = their rules,
# $5 = our hooks as they are now (hook_deletes), $6 = the hooks to put back, in
# -I order (the last one ends up first)
batch_commit() {
    case "$1" in
        6) _bres=ip6tables-restore ;;
        *) _bres=iptables-restore ;;
    esac
    _btxt="*${2}${NL}"
    for _c in $3; do
        _btxt="${_btxt}:${_c} - [0:0]${NL}"
    done
    _btxt="${_btxt}${4}${5:+${5}${NL}}${6}COMMIT"
    # The batch goes down a pipe from `echo`, the one builtin for that in both
    # mksh and dash. Not printf: on Android it is an external command, a rule set
    # past 128 KiB does not fit its argument, and the restore would then read an
    # empty stdin and report success with nothing committed. echo interprets
    # backslashes in both shells, and no rule of ours has one.
    case "$_btxt" in
        *\\*) log Warn "a rule for ${2} contains a backslash, ${_bres} not used"; return 1 ;;
    esac
    if [ "$DRY_RUN" = "1" ]; then
        echo "$_btxt" | sed "s/^/[dry-run] ${_bres} --noflush: /" >&2
        return 0
    fi
    _berr="$(echo "$_btxt" | "$_bres" $IPT_WAIT --noflush 2>&1)" && return 0
    log Warn "${_bres} refused the ${2} batch: $(printf '%s' "$_berr" | tr '\n' ' ')"
    return 1
}

# apply_proto's rule set for one family, committed table by table.
batch_proto() {  # $1 = i4|i6, $2 = 4|6 -> 1 when a table refused its batch
    case "$2" in
        6) _blst=ip6tables ;;
        *) _blst=iptables ;;
    esac
    BATCH=1; B_MANGLE=""; B_FILTER=""
    apply_proto "$1" "$2"
    BATCH=""
    _bdel="$(hook_deletes "$_blst" mangle)"
    _bins="-I PREROUTING -j ${c_ext}${NL}"
    # xt_socket is not in every kernel, and one unknown match fails the whole
    # batch. The DIVERT hook is part of it only once it is known to work, which
    # is when it is already there; the first time it is tried on its own, below.
    case "$_bdel" in
        *"-j ${c_divert}"*)
            _bins="${_bins}-I PREROUTING -p tcp -m socket --transparent -j ${c_divert}${NL}"
            _bdiv=1 ;;
        *)  _bdiv=0 ;;
    esac
    _bins="${_bins}-I OUTPUT -j ${c_local}${NL}-I INPUT -j ${c_input}${NL}"
    batch_commit "$2" mangle "$c_ext $c_local $c_divert $c_bypass $c_input" "$B_MANGLE" "$_bdel" "$_bins" || return 1
    if [ "$_bdiv" = 0 ] &&
       ! $1 -t mangle -I PREROUTING -p tcp -m socket --transparent -j "$c_divert" 2>/dev/null; then
        log Warn "xt_socket mangle PREROUTING unsupported, skipping DIVERT"
    fi
    batch_commit "$2" filter "$c_guard" "$B_FILTER" "$(hook_deletes "$_blst" filter)" \
        "-I OUTPUT -j ${c_guard}${NL}" || return 1
    return 0
}

# IPv6 in the modes that do not proxy it: the tproxy-port guard (every mode)
# and the block chain (ipv6=block).
batch_v6_rest() {  # $1 = ipv6 mode
    BATCH=1; B_MANGLE=""; B_FILTER=""
    apply_input i6
    [ "$1" = block ] && apply_v6_block
    BATCH=""
    batch_commit 6 mangle "$c_input" "$B_MANGLE" "$(hook_deletes ip6tables mangle)" \
        "-I INPUT -j ${c_input}${NL}" || return 1
    [ "$1" = block ] || return 0
    batch_commit 6 filter "$c_v6" "$B_FILTER" "$(hook_deletes ip6tables filter)" \
        "-I OUTPUT -j ${c_v6}${NL}-I FORWARD -j ${c_v6}${NL}"
}

on_batch() {  # $1 = ipv6 mode -> 1 as soon as a table refuses its batch
    batch_proto i4 4 || return 1
    case "$1" in
        proxy) batch_proto i6 6 || return 1 ;;
        *)     batch_v6_rest "$1" || return 1 ;;
    esac
    # ipv6=disable: what `on` switched off stays off across a renew. Putting
    # the stack back first, as the rebuild did, is IPv6 on for as long as the
    # rebuild takes. The first `on` records and disables every interface, a
    # later one only what netd turned on again.
    if [ "$1" = disable ]; then
        if [ -f "$v6_stack_saved" ]; then enforce_v6_disable; else apply_v6_disable; fi
    fi
    return 0
}

# The rule-by-rule build, on a table `do_off quiet` has just emptied.
on_rules() {  # $1 = ipv6 mode
    apply_proto i4 4
    case "$1" in
        proxy)   apply_proto i6 6 ;;
        block)   apply_v6_block; apply_input i6 ;;
        disable) apply_v6_disable; apply_input i6 ;;
        *)       apply_input i6 ;;
    esac
    return 0
}

# ------------------------------------------------------------------ actions

ipv6_mode() {
    case "${ipv6:-off}" in
        true|1|proxy)     echo proxy ;;
        false|0|block)    echo block ;;
        disable|-1|none)  echo disable ;;
        *) echo off ;;
    esac
}

# ipv6=disable: take the IPv6 stack away instead of rejecting packets.
# Rejecting IPv6 DNS leaves netd retrying a resolver it cannot reach (measured:
# 19 errors and 5 timeouts on fe80::1%wlan0) and, once its IPv4 resolvers are
# marked BROKEN (1800 s), with no working resolver at all: every uncached name
# failed. Removing the stack means netd has no IPv6 resolver to fall back to, so
# the IPv4 DNS hijack is the only path left, with nothing to leak through.
# The previous sysctl values are saved so `off` can put them back.
v6_stack_saved="${run_dir}/v6.stack.saved"


# Record one interface's current IPv6 sysctls, once, so `off` can put them back
# even for an interface that only appeared after this script ran.
v6_record() {  # $1 = interface name, or `default` for the template
    [ -f "$v6_stack_saved" ] || return 0
    grep -q "^$1 " "$v6_stack_saved" 2>/dev/null && return 0
    _d="/proc/sys/net/ipv6/conf/$1"
    [ -f "${_d}/disable_ipv6" ] || return 0
    printf '%s %s %s %s\n' "$1" \
        "$(cat "${_d}/disable_ipv6" 2>/dev/null)" \
        "$(cat "${_d}/accept_ra" 2>/dev/null)" \
        "$(cat "${_d}/autoconf" 2>/dev/null)" >> "$v6_stack_saved"
    return 0
}

v6_off() {  # $1 = interface name, or `default` for the template
    _d="/proc/sys/net/ipv6/conf/$1"
    sysctl_write "${_d}/disable_ipv6" 1
    sysctl_write "${_d}/accept_ra" 0
    sysctl_write "${_d}/autoconf" 0
    return 0
}

apply_v6_disable() {
    : > "$v6_stack_saved" 2>/dev/null
    # The `default` template first: an interface created after this point (netd
    # brings wlan0 up again, droidspaces creates ds-br0) inherits it, and such an
    # interface came up with disable_ipv6=0 on the device (measured 2026-11-04:
    # WiFi connected after the boot start, netd re-enabled IPv6, netd's resolver
    # list held fe80::1%wlan0 and names went out to the LAN router).
    # `all` stays untouched: writing it cascades to every interface, lo included,
    # and kills ::1 (measured: lo/disable_ipv6 became 1 even though lo was
    # skipped).
    v6_record default
    v6_off default
    _n=0
    for _d in /proc/sys/net/ipv6/conf/*; do
        _if="${_d##*/}"
        case "$_if" in all|default|lo) continue ;; esac
        [ -f "${_d}/disable_ipv6" ] || continue
        v6_record "$_if"
        v6_off "$_if"
        _n=$((_n + 1))
    done
    [ "$_n" -gt 0 ] || { log Warn "ipv6=disable: no /proc/sys/net/ipv6/conf entry to write"; return 0; }
    log Info "ipv6=disable: IPv6 stack off on ${_n} interface(s) + the new-interface template, lo kept"
    return 0
}

# netd turns IPv6 back on for a network it brings up, and an interface created
# after `on` inherits whatever the `default` template says at that moment. The
# watchdog calls this every tick (a few file reads) so `ipv6=disable` keeps its
# promise until `off`; the log line appears only when something was flipped.
enforce_v6_disable() {
    [ "$(ipv6_mode)" = "disable" ] || return 0
    [ -f "$v6_stack_saved" ] || return 0
    _changed=""
    _n=0
    # One `read` per file, no `cat`, and no write unless a value actually
    # drifted: this runs every watchdog tick forever, and the cat-based version
    # cost ~400 ms per pass on the device (34 interfaces x 3 forks).
    # `read` must not be used with `|| continue`: a /proc/sys value has no
    # trailing newline, so dash returns 1 there even though the variable is set
    # (measured on the host and inside the test namespace).
    _dft=""
    read -r _dft < /proc/sys/net/ipv6/conf/default/disable_ipv6 2>/dev/null
    if [ "${_dft:-1}" != "1" ]; then
        v6_off default
        _changed="default"
        _n=1
    fi
    for _d in /proc/sys/net/ipv6/conf/*; do
        _if="${_d##*/}"
        case "$_if" in all|default|lo) continue ;; esac
        [ -f "${_d}/disable_ipv6" ] || continue
        _v=""
        read -r _v < "${_d}/disable_ipv6" 2>/dev/null
        [ "${_v:-1}" = "1" ] && continue
        v6_record "$_if"
        v6_off "$_if"
        _changed="${_changed:+${_changed} }${_if}"
        _n=$((_n + 1))
    done
    if [ "$_n" -gt 0 ]; then
        log Info "ipv6=disable: switched IPv6 off again on ${_n} (${_changed}) - netd re-enables it on a new network"
    fi
    return 0
}

restore_v6_stack() {
    [ -f "$v6_stack_saved" ] || return 0
    while read -r _if _dis _ra _ac; do
        [ -n "${_if:-}" ] || continue
        _d="/proc/sys/net/ipv6/conf/${_if}"
        [ -d "$_d" ] || continue
        sysctl_write "${_d}/disable_ipv6" "${_dis:-0}"
        sysctl_write "${_d}/accept_ra" "${_ra:-1}"
        sysctl_write "${_d}/autoconf" "${_ac:-1}"
    done < "$v6_stack_saved"
    rm -f "$v6_stack_saved"
    log Info "ipv6: previous stack settings restored"
    return 0
}

do_on() {
    command -v iptables >/dev/null 2>&1 || { log Error "iptables not found"; return 1; }
    command -v ip >/dev/null 2>&1 || { log Error "ip not found"; return 1; }
    iptables $IPT_WAIT -t mangle -S >/dev/null 2>&1 || { log Error "mangle table unavailable"; return 1; }
    read_uid_list
    read_ap_list
    _v6="$(ipv6_mode)"
    # What the previous `on` left decides what has to go first; when nothing
    # changed, nothing does, and the set is swapped in place. No stamp is a
    # first `on`, or rules from a version that could not swap in place: start
    # from a clean table. Another ipv6 mode: only that mode's IPv6 side goes.
    _was="$(cat "$rules_stamp" 2>/dev/null)"
    if [ -z "$_was" ]; then
        do_off quiet
    elif [ "$_was" != "$_v6" ]; then
        restore_v6_stack
        teardown_proto i6 6
    fi
    if ! on_batch "$_v6"; then
        log Warn "falling back to the rule-by-rule build: the set is removed first, so the proxy is off until it is back"
        do_off quiet
        on_rules "$_v6"
    fi
    [ "$DRY_RUN" = "1" ] || printf '%s\n' "$_v6" > "$rules_stamp" 2>/dev/null
    [ "$_v6" = off ] && log Warn "ipv6=off: IPv6 traffic is NOT proxied and can leak"
    # One result line per `on`: the settings are in settings.ini, repeating them
    # on every renew is what made the logs noisy.
    log Info "rules installed: ${tproxy_port}/tcp+udp, table ${table}, mode ${proxy_mode}, ipv6 ${_v6}"
    return 0
}

do_off() {  # $1 = quiet (called from do_on, which reinstalls right away)
    restore_v6_stack
    teardown_proto i4 4
    teardown_proto i6 6
    [ "$DRY_RUN" = "1" ] || rm -f "$rules_stamp"
    [ "${1:-}" = "quiet" ] || log Info "TPROXY rules removed"
    return 0
}

do_status() {
    printf '== ip rule (v4)\n'
    ip rule show 2>/dev/null | grep -F "lookup ${table}" || printf '(none)\n'
    printf '== ip rule (v6)\n'
    ip -6 rule show 2>/dev/null | grep -F "lookup ${table}" || printf '(none)\n'
    printf '== route table %s\n' "$table"
    ip route show table "$table" 2>/dev/null || printf '(none)\n'
    printf '== mangle hooks\n'
    i4 -t mangle -S PREROUTING 2>/dev/null | grep -F PISING || printf '(v4 prerouting none)\n'
    i4 -t mangle -S OUTPUT 2>/dev/null | grep -F PISING || printf '(v4 output none)\n'
    i6 -t mangle -S PREROUTING 2>/dev/null | grep -F PISING || printf '(v6 none)\n'
    printf '== ipv6 mode: %s\n' "$(ipv6_mode)"
    if [ -f "$v6_stack_saved" ]; then
        _off=0
        _drift=""
        for _d in /proc/sys/net/ipv6/conf/*; do
            _if="${_d##*/}"
            case "$_if" in all|default|lo) continue ;; esac
            [ -f "${_d}/disable_ipv6" ] || continue
            if [ "$(cat "${_d}/disable_ipv6" 2>/dev/null)" = "1" ]; then
                _off=$((_off + 1))
            else
                _drift="${_drift:+${_drift} }${_if}"
            fi
        done
        printf '== ipv6 stack: off on %s interface(s), template %s\n' "$_off" \
            "$(cat /proc/sys/net/ipv6/conf/default/disable_ipv6 2>/dev/null)"
        [ -n "$_drift" ] && printf '== ipv6 on again (netd?): %s\n' "$_drift"
    fi
    printf '== PISING_LOCAL counters\n'
    i4 -t mangle -L "$c_local" -n -v 2>/dev/null || printf '(none)\n'
    return 0
}

case "${1:-}" in
    on|enable|renew) do_on ;;
    off|disable)     do_off ;;
    v6enforce)       enforce_v6_disable ;;
    status)          do_status ;;
    *)
        printf 'usage: %s {on|off|renew|v6enforce|status}\n' "$0" >&2
        exit 1
        ;;
esac
