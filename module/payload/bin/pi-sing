#!/system/bin/sh
# Pi-Sing control CLI.
#
#   pi-sing start | stop | restart | status | log [n] | iptables <arg> | update-core
#   pi-sing watchdog
#
# start  : validate settings and config, run sing-box, then install TPROXY rules
# stop   : remove TPROXY rules first, then stop sing-box
# status : process, rule and config summary (also used by action.sh)
set -u

PISING_DIR="${PISING_DIR:-/data/adb/pi-sing}"
settings="${PISING_DIR}/settings.ini"
[ -f "$settings" ] || { printf 'pi-sing: settings not found: %s\n' "$settings" >&2; exit 1; }
. "$settings"
# bin_dir/config_dir/run_dir come from settings.ini; refuse an old one instead of
# resolving paths against "/".
[ -n "${bin_dir:-}" ] && [ -n "${config_dir:-}" ] && [ -n "${run_dir:-}" ] ||
    { printf 'pi-sing: %s is from an older layout, reinstall the module\n' "$settings" >&2; exit 1; }

bin_path="${bin_dir}/${bin_name}"
config_path="${config_dir}/${config_file}"
pid_file="${run_dir}/pi-sing.pid"
# Written by `stop`, removed by `start`: the watchdog uses it to tell a user
# stop from a crash. Without it, the action button's OFF was undone 30 s later.
state_file="${run_dir}/stopped"
# log_dir comes from settings.ini; defaulted here for a settings file written by
# v1.3.0, which has no log_dir line.
log_dir="${log_dir:-${run_dir}/log}"
module_log="${log_dir}/module.log"
core_log="${log_dir}/sing-box.log"
mod_dir="${PISING_MOD_DIR:-/data/adb/modules/pi-sing}"
TAB="$(printf '\t')"

mkdir -p "$run_dir" "$log_dir" 2>/dev/null

# One line per event in log/module.log. The core writes to log/sing-box.log, so
# the two formats never mix in one file. PISING_QUIET=1 (service.sh, watchdog,
# rule calls) keeps stdout empty: the line is already in the log and nobody reads
# the service's stdout, so it would otherwise be written twice.
log() {
    _lvl="$1"; shift
    _msg="$(date '+%Y-%m-%d %H:%M:%S') [${_lvl}] [${PISING_LOG_TAG:-cli}] $*"
    _size=0
    [ -f "$module_log" ] && _size=$(wc -c < "$module_log" 2>/dev/null)
    if [ "${_size:-0}" -gt 262144 ]; then
        mv -f "$module_log" "${module_log}.1" 2>/dev/null
    fi
    printf '%s\n' "$_msg" >> "$module_log" 2>/dev/null
    [ "${PISING_QUIET:-0}" = "1" ] || printf '%s\n' "$_msg"
    return 0
}

# ---------------------------------------------------------------- internals

# busybox is what setuidgid comes from; KernelSU/Magisk/APatch each keep one in
# a different place and boot services do not always inherit a full PATH.
find_busybox() {
    for _b in "$(command -v busybox 2>/dev/null)" \
              /data/adb/ksu/bin/busybox /data/adb/magisk/busybox \
              /data/adb/ap/bin/busybox /system/xbin/busybox; do
        if [ -n "$_b" ] && [ -x "$_b" ]; then
            printf '%s' "$_b"
            return 0
        fi
    done
    return 1
}

find_pid() {
    if command -v pidof >/dev/null 2>&1; then
        _p="$(pidof "$bin_name" 2>/dev/null | awk '{ print $1 }')"
        if [ -n "${_p:-}" ]; then
            printf '%s' "$_p"
            return 0
        fi
    fi
    # pidof matches the kernel's comm, which is not bin_name when the core is a
    # wrapper (or was renamed); the full command line still contains bin_path.
    if command -v pgrep >/dev/null 2>&1; then
        pgrep -f "$bin_path" 2>/dev/null | head -n 1
    else
        ps -A 2>/dev/null | awk -v b="$bin_path" 'index($0, b) { print $2; exit }'
    fi
}

running_pid() {
    _pid="$(cat "$pid_file" 2>/dev/null)"
    if [ -n "${_pid:-}" ] && kill -0 "$_pid" 2>/dev/null; then
        printf '%s' "$_pid"
        return 0
    fi
    find_pid
}

# The root manager shows module.prop's description under the module card. A
# stopped core cannot say anything by itself (there is no process), so every
# state change writes one line there: 🟢 running / 🔴 stopped, the way
# android-bridge does it. The write is skipped when the text is unchanged, so
# the watchdog does not touch the file every interval.
update_desc() {
    _prop="${mod_dir}/module.prop"
    [ -f "$_prop" ] || return 0
    _desc="$1 | sing-box + TPROXY ${proxy_mode:-?}, ${tproxy_port:-?}"
    _cur="$(sed -n 's/^description=//p' "$_prop" 2>/dev/null | head -n 1)"
    [ "$_cur" = "$_desc" ] && return 0
    sed -i "s#^description=.*#description=${_desc}#" "$_prop" 2>/dev/null
    return 0
}

# Sets _dash_line/_dash_old/_dash_new from services[].dashboard. A relative path
# is resolved next to config.json, never against -D run/: the dashboard files
# belong with the config that names them. An absolute path is used untouched.
read_dashboard() {
    _dash_line=0 _dash_old="" _dash_new=""
    [ -f "$config_path" ] || return 1
    _found="$(awk -v base="$config_dir" '
        function resolve(p) { return (p ~ /^\//) ? p : base "/" p }
        { line[NR] = $0 }
        END {
            for (i = 1; i <= NR; i++) {
                if (line[i] ~ /"dashboard"[ \t]*:[ \t]*"/) {
                    v = line[i]
                    sub(/^.*"dashboard"[ \t]*:[ \t]*"/, "", v)
                    sub(/".*$/, "", v)
                    if (v != "") print i "\t" v "\t" resolve(v)
                    exit
                }
                if (line[i] ~ /"dashboard"[ \t]*:[ \t]*\{/) {
                    # a one-line object: { "path": "ui" } on the same line
                    if (line[i] ~ /"path"[ \t]*:[ \t]*"/) {
                        v = line[i]
                        sub(/^.*"path"[ \t]*:[ \t]*"/, "", v)
                        sub(/".*$/, "", v)
                        if (v != "") print i "\t" v "\t" resolve(v)
                        exit
                    }
                    for (j = i + 1; j <= NR; j++) {
                        if (line[j] ~ /^[ \t]*\}/) break
                        if (line[j] ~ /"path"[ \t]*:[ \t]*"/) {
                            v = line[j]
                            sub(/^.*"path"[ \t]*:[ \t]*"/, "", v)
                            sub(/".*$/, "", v)
                            if (v != "") print j "\t" v "\t" resolve(v)
                            exit
                        }
                    }
                    exit
                }
            }
        }' "$config_path")"
    [ -n "${_found:-}" ] || return 1
    _dash_line="${_found%%"$TAB"*}"
    _rest="${_found#*"$TAB"}"
    _dash_old="${_rest%%"$TAB"*}"
    _dash_new="${_rest#*"$TAB"}"
    return 0
}

dashboard_path() {
    read_dashboard || return 0
    printf '%s' "$_dash_new"
}

sync_dashboard() {
    read_dashboard || return 0
    [ "$_dash_old" = "$_dash_new" ] && return 0
    _tmp="${run_dir}/config.dash.tmp"
    awk -v ln="$_dash_line" -v abs="$_dash_new" '
        NR == ln {
            if ($0 ~ /"dashboard"[ \t]*:[ \t]*\{/)
                sub(/"path"[ \t]*:[ \t]*"[^"]*"/, "\"path\": \"" abs "\"")
            else if ($0 ~ /"dashboard"[ \t]*:/)
                sub(/"dashboard"[ \t]*:[ \t]*"[^"]*"/, "\"dashboard\": \"" abs "\"")
            else
                sub(/"path"[ \t]*:[ \t]*"[^"]*"/, "\"path\": \"" abs "\"")
        }
        { print }' "$config_path" > "$_tmp" 2>/dev/null
    if [ -s "$_tmp" ]; then
        mv -f "$_tmp" "$config_path"
        log Info "dashboard: ${_dash_old} -> ${_dash_new}"
    fi
    rm -f "$_tmp"
    return 0
}

# settings.ini owns the core log level. The core writes into log/sing-box.log,
# and one INFO line per connection is the bulk of the module's disk writes on a
# phone, so the default is warn. "config" leaves config.json in charge.
sync_log_level() {
    # The default has to be resolved in a variable: an old settings.ini has no
    # core_log_level line, and "$core_log_level" under set -u would fail before
    # awk ever runs.
    _lvl="${core_log_level:-warn}"
    case "$_lvl" in
        ""|config|keep) return 0 ;;
        trace|debug|info|warn|error|fatal|panic) ;;
        *) log Warn "core_log_level=${core_log_level} is not a level, using config.json"; return 0 ;;
    esac
    _tmp="${run_dir}/config.level.tmp"
    awk -v lvl="$_lvl" '
        /"log"[ \t]*:[ \t]*\{/ { inlog = 1 }
        inlog && /"level"[ \t]*:[ \t]*"/ {
            sub(/"level"[ \t]*:[ \t]*"[^"]*"/, "\"level\": \"" lvl "\"")
            inlog = 0
        }
        inlog && /^[ \t]*\}/ { inlog = 0 }
        { print }' "$config_path" > "$_tmp" 2>/dev/null
    if [ -s "$_tmp" ] && ! cmp -s "$_tmp" "$config_path"; then
        mv -f "$_tmp" "$config_path"
    fi
    rm -f "$_tmp"
    return 0
}

http_probe() {  # $1 = url, $2 = optional command prefix ("busybox setuidgid 0:3005")
    _url="$1"
    _wrap="${2:-}"
    if command -v curl >/dev/null 2>&1; then
        _cmd="curl -s -m 10 -o /dev/null $_url"
    else
        _cmd="wget -q -O /dev/null -T 10 $_url"
    fi
    # shellcheck disable=SC2086
    $_wrap $_cmd >/dev/null 2>&1
}

# Two probes: one from a socket exempted by the rules (direct) and one that the
# rules must capture (proxied). If direct works but proxied does not, the tunnel
# is down and the rules stay (fail closed, no leak). If both fail, the rules
# themselves are broken and are removed so the phone keeps its connection.
selftest() {
    [ "${selftest:-0}" = "1" ] || return 0
    if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
        log Warn "selftest skipped: no curl/wget on the device"
        return 0
    fi
    _bb="$(find_busybox)"
    _gid="$(cat "${run_dir}/core.gid" 2>/dev/null)"
    _direct=""
    if [ -n "${_gid:-}" ] && [ -n "${_bb:-}" ]; then
        http_probe https://1.1.1.1/cdn-cgi/trace "$_bb setuidgid 0:$_gid" && _direct=1
    else
        http_probe https://1.1.1.1/cdn-cgi/trace && _direct=1
    fi
    if [ -n "$_direct" ]; then
        log Info "selftest: direct path ok"
    else
        log Warn "selftest: direct path failed (no internet before the rules?)"
    fi
    sleep 1
    if http_probe https://1.1.1.1/cdn-cgi/trace; then
        log Info "selftest: proxied path ok"
        return 0
    fi
    if [ -n "$_direct" ]; then
        log Warn "selftest: proxied path failed, tunnel is probably down (rules kept, fail closed)"
        update_desc "🟠 Running - tunnel down"
        return 1
    fi
    log Error "selftest: both paths failed, removing the rules to keep the phone online"
    "${bin_dir}/pi.iptables" off >/dev/null 2>&1
    update_desc "🟠 Rules off (selftest)"
    return 1
}

launch() {
    if command -v nohup >/dev/null 2>&1; then
        if command -v setsid >/dev/null 2>&1; then
            nohup setsid "$@" >> "$core_log" 2>&1 &
        else
            nohup "$@" >> "$core_log" 2>&1 &
        fi
    elif command -v setsid >/dev/null 2>&1; then
        setsid "$@" >> "$core_log" 2>&1 &
    else
        "$@" >> "$core_log" 2>&1 &
    fi
}

# settings.ini owns tproxy_port: rewrite only the tproxy inbound object so
# other inbounds (mixed/http/socks) keep their own port.
sync_config() {
    [ -f "$config_path" ] || { log Error "config not found: $config_path"; return 1; }
    _tmp="${run_dir}/config.sync.tmp"
    awk -v port="$tproxy_port" '
        { line[NR] = $0 }
        /"inbounds"[[:space:]]*:/ { inb = 1; obj = 0; nobj = 0 }
        inb {
            if ($0 ~ /\{/ && obj == 0) obj = NR
            if ($0 ~ /\}/ && obj > 0) { objs[++nobj] = obj " " NR; obj = 0 }
            if ($0 ~ /^[[:space:]]*\][[:space:]]*,?[[:space:]]*$/) inb = 0
        }
        END {
            for (i = 1; i <= nobj; i++) {
                split(objs[i], r, " ")
                istp = 0
                for (j = r[1]; j <= r[2]; j++)
                    if (line[j] ~ /"type"[[:space:]]*:[[:space:]]*"[a-z-]*tproxy"/) istp = 1
                if (istp)
                    for (j = r[1]; j <= r[2]; j++) tp[j] = 1
            }
            for (i = 1; i <= NR; i++) {
                if (tp[i] && line[i] ~ /"listen_port"[[:space:]]*:/)
                    sub(/:[[:space:]]*[0-9]+/, ": " port, line[i])
                print line[i]
            }
        }' "$config_path" > "$_tmp" 2>/dev/null && [ -s "$_tmp" ] && mv -f "$_tmp" "$config_path"

    if ! grep -q '"type": *"[a-z-]*tproxy"' "$config_path"; then
        log Warn "no tproxy inbound in ${config_path}: this module only works with a tproxy inbound"
        return 0
    fi
    # optional second loop guard: sing-box sets SO_MARK on its own outbound sockets
    sed -i "s/\(\"routing_mark\"[[:space:]]*:[[:space:]]*\)[0-9]\+/\1${routing_mark}/g" "$config_path"
    sync_dashboard
    sync_log_level
    return 0
}

# --disable-color keeps ANSI escapes out of a file that is never a terminal.
# Older cores do not know the flag, so it is detected instead of assumed.
core_flags() {
    "$bin_path" run --help 2>&1 | grep -q -- '--disable-color' && printf '%s' '--disable-color'
    return 0
}

# sing-box validates the config (schema + rule sets) before we touch any rule.
check_config() {
    # shellcheck disable=SC2046
    "$bin_path" check -D "$run_dir" -c "$config_path" $(core_flags) >> "$core_log" 2>&1
}

# One core log per run. The previous one stays as sing-box.log.1, so the reason
# a core died can still be read after the next start, and the file never grows
# forever on a phone that does not reboot.
prepare_core_log() {
    mkdir -p "$log_dir" 2>/dev/null
    [ -s "$core_log" ] && mv -f "$core_log" "${core_log}.1" 2>/dev/null
    printf '== %s | %s start ==\n' "$(core_version "$bin_path")" "$(date '+%F %T')" >> "$core_log"
    return 0
}

# Wait for the process to appear instead of sleeping a fixed 2 s. The core
# usually reports its pid in under 300 ms; a dead core fails the start sooner.
wait_pid() {  # $1 = seconds; prints the first pid found
    _n=0
    _max=$(( ${1:-5} * 10 ))
    while [ "$_n" -lt "$_max" ]; do
        _p="$(find_pid)"
        if [ -n "${_p:-}" ]; then
            printf '%s' "$_p"
            return 0
        fi
        sleep 0.1
        _n=$((_n + 1))
    done
    return 1
}

# Start the core as ${core_user}:${core_group} so pi.iptables can bypass it by
# gid. Without that the core's own outbound traffic (DNS first) matches the
# proxy rules again and loops. Falls back to a uid 0 bypass.
start_core() {
    if [ -n "${core_group:-}" ] && [ -n "${core_gid:-}" ]; then
        _bb="$(find_busybox)"
        if [ -n "${_bb:-}" ] &&
           [ "$("$_bb" id -g "$core_group" 2>/dev/null)" = "$core_gid" ]; then
            printf '%s\n' "$core_gid" > "${run_dir}/core.gid"
            log Info "core runs as ${core_user}:${core_group} (gid ${core_gid}) via ${_bb}"
            launch "$_bb" setuidgid "${core_user}:${core_group}" "$@"
            return 0
        fi
        if command -v setpriv >/dev/null 2>&1 &&
           setpriv --reuid=0 --regid="$core_gid" --clear-groups true 2>/dev/null; then
            printf '%s\n' "$core_gid" > "${run_dir}/core.gid"
            log Info "core runs as 0:${core_gid} via setpriv"
            launch setpriv --reuid=0 --regid="$core_gid" --clear-groups "$@"
            return 0
        fi
    fi
    rm -f "${run_dir}/core.gid"
    log Warn "cannot set group ${core_group:-net_admin}: core runs as root, root traffic bypasses the proxy (uid 0)"
    launch "$@"
}

# ----------------------------------------------------------------- actions

do_start() {
    rm -f "$state_file"
    if [ ! -x "$bin_path" ]; then
        log Error "no core at ${bin_path}: run 'pi-sing update-core' to install one"
        update_desc "🔴 No core"
        return 1
    fi
    _running="$(running_pid)"
    if [ -n "${_running:-}" ]; then
        printf '%s\n' "$_running" > "$pid_file"
        log Info "already running (pid ${_running})"
        update_desc "🟢 Running (pid ${_running})"
        return 0
    fi
    sync_config || return 1
    prepare_core_log
    if ! check_config; then
        log Error "sing-box check failed, see ${core_log}"
        update_desc "🔴 Config error"
        return 1
    fi
    log Info "starting ${bin_name} (log: ${core_log})"
    # shellcheck disable=SC2046
    start_core "$bin_path" run -D "$run_dir" -c "$config_path" $(core_flags)
    _pid="$(wait_pid 6)"
    if [ -z "${_pid:-}" ]; then
        log Error "sing-box exited, see ${core_log}"
        update_desc "🔴 Failed to start"
        return 1
    fi
    printf '%s\n' "$_pid" > "$pid_file"
    log Info "sing-box running (pid ${_pid})"
    if ! PISING_QUIET=1 "${bin_dir}/pi.iptables" on; then
        log Error "failed to install TPROXY rules, see ${module_log}"
        update_desc "🔴 Rules error"
        return 1
    fi
    update_desc "🟢 Running (pid ${_pid})"
    selftest || return 1
    return 0
}

do_stop() {
    # Set before the core is killed, so a watchdog tick cannot see "no process"
    # and restart it between the kill and the end of this function.
    : > "$state_file" 2>/dev/null
    [ -x "${bin_dir}/pi.iptables" ] && PISING_QUIET=1 "${bin_dir}/pi.iptables" off
    _pid="$(running_pid)"
    if [ -n "${_pid:-}" ]; then
        kill -15 "$_pid" 2>/dev/null
        _n=0
        while [ "$_n" -lt 20 ] && kill -0 "$_pid" 2>/dev/null; do
            sleep 0.5
            _n=$((_n + 1))
        done
        kill -0 "$_pid" 2>/dev/null && kill -9 "$_pid" 2>/dev/null
        log Info "sing-box stopped (pid ${_pid})"
    else
        log Info "sing-box is not running"
    fi
    rm -f "$pid_file" "${run_dir}/core.gid"
    update_desc "🔴 Stopped"
    return 0
}

do_status() {
    _pid="$(running_pid)"
    _ver=""
    [ -x "$bin_path" ] && _ver="$("$bin_path" version 2>/dev/null | head -n 1)"
    printf 'pi-sing    : %s\n' "${_ver:-missing - run: pi-sing update-core}"
    printf 'settings   : %s (mode=%s, port=%s, ipv6=%s, quic=%s)\n' \
        "$settings" "$proxy_mode" "$tproxy_port" "$ipv6" "$quic"
    printf 'config     : %s\n' "$config_path"
    if [ -n "${_pid:-}" ]; then
        printf 'process    : running (pid %s, %s)\n' "$_pid" \
            "$(ps -o etime= -p "$_pid" 2>/dev/null | tr -d ' ')"
    else
        printf 'process    : stopped\n'
    fi
    _rules="$(ip rule show 2>/dev/null | grep -cF "lookup ${table}")"
    printf 'rules      : %s ip rule entr(ies) for table %s\n' "${_rules:-0}" "$table"
    iptables -t mangle -S OUTPUT 2>/dev/null | grep -qF PISING_LOCAL &&
        printf 'iptables   : hooked into mangle OUTPUT/PREROUTING\n' ||
        printf 'iptables   : not hooked\n'
    _dash="$(dashboard_path)"
    if [ -n "${_dash:-}" ]; then
        if [ -d "$_dash" ]; then
            printf 'dashboard  : %s (served by services.api)\n' "$_dash"
        else
            printf 'dashboard  : %s (missing, the core fills it on start)\n' "$_dash"
        fi
    fi
    printf 'logs       : %s/{module,sing-box}.log\n' "$log_dir"
    return 0
}

do_log() {
    case "${1:-}" in
        core|sing-box) _file="$core_log"; shift ;;
        *)             _file="$module_log" ;;
    esac
    _lines="${1:-40}"
    tail -n "$_lines" "$_file" 2>/dev/null || printf '(no log yet: %s)\n' "$_file"
    return 0
}

# ----------------------------------------------------------- core update
# `update-core` follows GitHub's "latest" release, so nothing is pinned here: the
# tag and the asset's sha256 digest both come from the same API response, and the
# download is verified against that digest. A new core must pass `check` with the
# live config and must stay up after start, otherwise the previous binary is put
# back. PISING_UPDATE_* exist for the tests only.
UPDATE_API="${PISING_UPDATE_API:-https://api.github.com/repos/SagerNet/sing-box/releases/latest}"
UPDATE_DL="${PISING_UPDATE_DL:-https://github.com/SagerNet/sing-box/releases/download}"

# ro.product.cpu.abi -> the GOARCH tag in the release asset name.
core_arch() {
    _abi="${PISING_UPDATE_ARCH:-$(getprop ro.product.cpu.abi 2>/dev/null)}"
    [ -n "${_abi:-}" ] || _abi="$(uname -m 2>/dev/null)"
    case "$_abi" in
        arm64*|aarch64*)         printf 'arm64' ;;
        armeabi*|armv7*|armv8l*) printf 'arm' ;;
        x86_64*|amd64*)          printf 'amd64' ;;
        x86|i?86*)               printf '386' ;;
        *) return 1 ;;
    esac
}

# $3 = "keep" leaves an HTTP error body in $2: the GitHub API answers 403 with an
# explanation worth reading, and the download is still checked by digest.
fetch_url() {  # $1 = url, $2 = output file, $3 = keep (optional)
    _opt="-f"
    [ "${3:-}" = "keep" ] && _opt=""
    if command -v curl >/dev/null 2>&1; then
        curl -sSL $_opt --retry 2 --connect-timeout 15 -m 300 -o "$2" "$1"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$2" "$1"
    else
        return 1
    fi
}

sha256_of() {  # $1 = file -> hex digest on stdout
    _bb="$(find_busybox)"
    if [ -n "${_bb:-}" ] && "$_bb" sha256sum "$1" >/dev/null 2>&1; then
        "$_bb" sha256sum "$1" | awk '{ print $1; exit }'
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{ print $1; exit }'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{ print $1; exit }'
    else
        return 1
    fi
}

core_version() {  # $1 = binary path -> version string
    "$1" version 2>/dev/null | head -n 1 | awk '{ print $NF }'
}

# Undo the swap. A thin install has no previous core, so there is nothing to put
# back and the new binary is removed instead (same state as before the attempt).
restore_prev() {  # reads _upd from do_update_core
    if [ -f "${_upd}/sing-box.prev" ]; then
        cp -f "${_upd}/sing-box.prev" "$bin_path" && chmod 755 "$bin_path"
    else
        rm -f "$bin_path"
    fi
}

do_update_core() {
    _arch="$(core_arch)" ||
        { log Error "update: unsupported cpu abi ($(getprop ro.product.cpu.abi 2>/dev/null))"; return 1; }
    _upd="${run_dir}/update"
    rm -rf "$_upd"
    mkdir -p "$_upd" || { log Error "update: cannot create ${_upd}"; return 1; }

    log Info "update: querying the latest sing-box release (android-${_arch})"
    if ! fetch_url "$UPDATE_API" "${_upd}/release.json" keep; then
        log Error "update: cannot fetch ${UPDATE_API} (no network?)"
        return 1
    fi
    _tag="$(sed -n 's/^[[:space:]]*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' "${_upd}/release.json" | head -n 1)"
    if [ -z "${_tag:-}" ]; then
        log Error "update: no tag_name in the API response (rate limited?), see ${_upd}/release.json"
        return 1
    fi
    _ver="${_tag#v}"
    _tar="sing-box-${_ver}-android-${_arch}.tar.gz"

    _cur="$(core_version "$bin_path")"
    if [ "${_cur:-}" = "$_ver" ]; then
        log Info "update: already on the latest core (${_ver})"
        rm -rf "$_upd"
        return 0
    fi

    # The digest sits in the same asset object as the name; scan forward until
    # the next asset starts so another asset's digest is never picked up.
    _want="$(awk -v name="\"name\": \"${_tar}\"" '
        index($0, name) { on = 1; next }
        on && /"name":[[:space:]]*"/ { exit }
        on && /"digest":[[:space:]]*"sha256:/ {
            sub(/.*"digest":[[:space:]]*"sha256:/, "")
            sub(/".*/, "")
            print
            exit
        }' "${_upd}/release.json")"
    if [ -z "${_want:-}" ]; then
        log Error "update: ${_tag} publishes no sha256 digest for ${_tar}, refusing to install it"
        return 1
    fi

    log Info "update: ${_cur:-unknown} -> ${_ver}, downloading ${_tar}"
    if ! fetch_url "${UPDATE_DL}/${_tag}/${_tar}" "${_upd}/${_tar}"; then
        log Error "update: download failed: ${UPDATE_DL}/${_tag}/${_tar}"
        return 1
    fi
    _got="$(sha256_of "${_upd}/${_tar}")" ||
        { log Error "update: no sha256sum/shasum on this device"; return 1; }
    if [ "$_got" != "$_want" ]; then
        log Error "update: sha256 mismatch for ${_tar} (want ${_want}, got ${_got})"
        return 1
    fi
    log Info "update: sha256 ok (${_want})"

    ( cd "$_upd" && tar -xzf "$_tar" ) >> "$module_log" 2>&1 ||
        { log Error "update: cannot extract ${_tar}"; return 1; }
    _src="${_upd}/sing-box-${_ver}-android-${_arch}"
    [ -f "${_src}/sing-box" ] ||
        { log Error "update: ${_tar} contains no sing-box binary"; return 1; }
    _lic=""
    [ -f "${_src}/LICENSE" ] && _lic="${_src}/LICENSE"
    chmod 755 "${_src}/sing-box"

    _newver="$(core_version "${_src}/sing-box")"
    case "${_newver:-}" in
        "$_ver"*) ;;
        *) log Error "update: downloaded binary reports '${_newver:-no output}', expected ${_ver}"; return 1 ;;
    esac
    # -D a scratch dir: the live cache.db belongs to the running core.
    mkdir -p "${_upd}/check"
    if [ -f "$config_path" ] &&
       ! "${_src}/sing-box" check -D "${_upd}/check" -c "$config_path" >> "$module_log" 2>&1; then
        log Error "update: core ${_ver} rejects ${config_path}, keeping ${_cur:-the current core}"
        return 1
    fi

    _was_running="$(running_pid)"
    if [ -x "$bin_path" ]; then
        cp -f "$bin_path" "${_upd}/sing-box.prev" ||
            { log Error "update: cannot back up ${bin_path}"; return 1; }
    else
        rm -f "${_upd}/sing-box.prev"
        log Info "update: no current core, installing ${_ver} from scratch"
    fi
    # The file is swapped before the core is stopped, so a watchdog restart in
    # between starts the already validated new binary, never the stale one.
    if ! mv -f "${_src}/sing-box" "$bin_path" || ! chmod 755 "$bin_path"; then
        restore_prev
        log Error "update: cannot replace ${bin_path}"
        return 1
    fi
    [ -n "$_lic" ] && cp -f "$_lic" "${bin_dir}/sing-box.LICENSE"
    if [ -n "${_was_running:-}" ]; then
        do_stop >/dev/null 2>&1
        do_start
    fi
    if [ -n "${_was_running:-}" ] && [ -z "$(running_pid)" ]; then
        restore_prev
        log Error "update: core ${_ver} did not stay up, rolled back to ${_cur:-the previous core}"
        do_start
        return 1
    fi
    log Info "update: core ${_cur:-unknown} -> ${_ver} (android-${_arch})"
    rm -rf "$_upd"
    return 0
}

do_watchdog() {
    [ "$watchdog" = "1" ] || { log Info "watchdog disabled"; return 0; }
    log Info "watchdog started (${watchdog_interval}s)"
    _iface=""
    _nocore=0
    _last=""
    while :; do
        sleep "$watchdog_interval"
        if [ -f "$state_file" ]; then
            # A user stop (action button / `pi-sing stop`): stay down. A crash
            # has no flag, so it is still restarted.
            _last=""
            continue
        fi
        _now="$(running_pid)"
        if [ -z "${_now:-}" ]; then
            if [ -x "$bin_path" ]; then
                _nocore=0
                log Warn "sing-box is gone, restarting"
                do_start || sleep 30
            elif [ "$_nocore" = "0" ]; then
                # A thin install can boot without a core. Retrying every interval
                # would only repeat the same error, so say it once and wait.
                _nocore=1
                log Warn "no core at ${bin_path}: run 'pi-sing update-core' (watchdog idle)"
                update_desc "🔴 No core"
            fi
            _last=""
        elif [ "$_now" != "$_last" ]; then
            # Keeps the module card honest even when somebody starts or stops the
            # core outside this watchdog.
            update_desc "🟢 Running (pid ${_now})"
            _last="$_now"
            _nocore=0
        fi
        _cur="$(ip route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')"
        if [ -n "$_cur" ] && [ "$_cur" != "$_iface" ]; then
            if [ -n "$_iface" ]; then
                log Info "default interface ${_iface} -> ${_cur}, renewing rules"
                PISING_QUIET=1 "${bin_dir}/pi.iptables" renew
            fi
            _iface="$_cur"
        fi
    done
}

case "${1:-}" in
    start)    do_start ;;
    stop)     do_stop ;;
    restart)  do_stop; do_start ;;
    status)   do_status ;;
    log)      shift; do_log "$@" ;;
    iptables) shift; "${bin_dir}/pi.iptables" "${1:-status}" ;;
    update-core) do_update_core ;;
    watchdog) do_watchdog ;;
    mark)     shift; update_desc "$*" ;;
    *)
        printf 'usage: %s {start|stop|restart|status|log [core] [n]|iptables <on|off|renew|status>|update-core|watchdog|mark <state>}\n' "$0" >&2
        exit 1
        ;;
esac
